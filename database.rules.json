{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "polls": {
          "$pid": {
            ".validate": "newData.isNumber() && $pid.matches(/^[a-z0-9]{6}$/)"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "polls": {
      "$pid": {
        ".read": "$pid.matches(/^[a-z0-9]{6}$/)",
        "meta": {
          ".write": "auth != null && $pid.matches(/^[a-z0-9]{6}$/) && ((!data.exists() && newData.child('owner').val() == auth.uid) || data.child('owner').val() == auth.uid)",
          ".validate": "newData.hasChildren(['owner', 'q', 'open', 'at']) && (newData.hasChild('opts') || newData.child('type').val() == 'text')",
          "owner": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "q": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "opts": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            }
          },
          "open": {
            ".validate": "newData.isBoolean()"
          },
          "ask": {
            ".validate": "newData.isBoolean()"
          },
          "res": {
            ".validate": "newData.isBoolean()"
          },
          "link": {
            ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().matches(/^https:\\/\\//)"
          },
          "linkLabel": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "type": {
            ".validate": "newData.val() == 'text'"
          },
          "max": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
          },
          "hide": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            }
          },
          "mod": {
            ".validate": "newData.isBoolean()"
          },
          "sib": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]$/) && newData.isString() && newData.val().matches(/^[a-z0-9]{6}$/)"
            }
          },
          "flow": {
            ".validate": "newData.val() == 'self' || newData.val() == 'with'"
          },
          "wait": {
            ".validate": "newData.isBoolean()"
          },
          "rev": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
          },
          "qz": {
            ".validate": "newData.val() == 'solo' || newData.val() == 'bell'"
          },
          "seats": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 40"
          },
          "nshow": {
            ".validate": "newData.isBoolean()"
          },
          "rv": {
            ".validate": "newData.isBoolean()"
          },
          "multi": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "votes": {
          ".write": "auth != null && !newData.exists() && root.child('polls').child($pid).child('meta').child('owner').val() == auth.uid",
          "$vid": {
            ".write": "$vid.matches(/^[a-z0-9]{12,24}$/) && ((newData.exists() && root.child('polls').child($pid).child('meta').child('open').val() == true && !root.child('polls').child($pid).child('meta').child('rev').exists()) || (!newData.exists() && auth != null && root.child('polls').child($pid).child('meta').child('owner').val() == auth.uid))",
            ".validate": "newData.hasChild('at') && (newData.hasChild('c') || newData.hasChild('a') || newData.hasChild('m'))",
            "c": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "a": {
              "$i": {
                ".validate": "$i.matches(/^[0-4]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
              }
            },
            "m": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
              }
            },
            "at": {
              ".validate": "newData.val() == now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "keys": {
      "$pid": {
        ".read": "auth != null && root.child('polls').child($pid).child('meta').child('owner').val() == auth.uid",
        ".write": "auth != null && root.child('polls').child($pid).child('meta').child('owner').val() == auth.uid",
        ".validate": "newData.hasChildren(['a'])",
        "a": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "seats": {
      "$root": {
        ".read": "$root.matches(/^[a-z0-9]{6}$/)",
        ".write": "auth != null && root.child('polls').child($root).child('meta').child('owner').val() == auth.uid && !newData.exists()",
        "$n": {
          ".write": "$n.matches(/^[0-9]{1,2}$/) && (!data.exists() || (auth != null && root.child('polls').child($root).child('meta').child('owner').val() == auth.uid))",
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{6}$/)"
        }
      }
    },
    "skeys": {
      "$root": {
        ".read": "auth != null && root.child('polls').child($root).child('meta').child('owner').val() == auth.uid",
        ".write": "auth != null && root.child('polls').child($root).child('meta').child('owner').val() == auth.uid && !newData.exists()",
        "$n": {
          ".write": "$n.matches(/^[0-9]{1,2}$/) && (!data.exists() || (auth != null && root.child('polls').child($root).child('meta').child('owner').val() == auth.uid))",
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{16}$/)"
        }
      }
    },
    "scores": {
      "$root": {
        ".write": "auth != null && root.child('polls').child($root).child('meta').child('owner').val() == auth.uid",
        "$k": {
          ".read": true
        }
      }
    }
  }
}
